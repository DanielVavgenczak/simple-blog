<% content_for :title, "Posts" %>

<div id="posts">
  <% if @posts.any? %>
    <% @posts.each do |post| %>
      <article class="py-10 border-b border-gray-100 last:border-b-0">
        <h2 class="text-2xl font-bold text-gray-900 hover:text-gray-600 mb-2">
          <%= link_to post.title, post %>
        </h2>
        <p class="text-gray-600 mb-4 line-clamp-2"><%= truncate(post.content, length: 200) %></p>
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-4 text-sm text-gray-500">
            <span><%= time_ago_in_words(post.created_at) %> ago</span>
          </div>
          <div class="flex items-center space-x-2">
            <%= link_to "Edit", edit_post_path(post), class: "text-sm text-gray-500 hover:text-gray-900 font-medium" %>
            <%= button_to "Delete", post, method: :delete, class: "text-sm text-red-500 hover:text-red-700 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
          </div>
        </div>
      </article>
    <% end %>
  <% else %>
    <div class="text-center py-16">
      <p class="text-gray-500 mb-4">No posts yet</p>
      <%= link_to "Write your first post", new_post_path, class: "text-blue-600 hover:text-blue-500 font-medium" %>
    </div>
  <% end %>
</div>