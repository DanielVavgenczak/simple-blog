<%= form_with(model: post, class: "space-y-6") do |form| %>
  <% if post.errors.any? %>
    <div class="bg-red-50 text-red-600 px-4 py-3 rounded-md text-sm">
      <ul class="list-disc ml-4">
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-sm font-semibold text-gray-900 mb-2" %>
    <%= form.text_field :title, placeholder: "Title", class: "w-full text-3xl font-bold text-gray-900 placeholder-gray-300 border-0 border-b-2 border-gray-200 focus:border-gray-900 focus:ring-0 px-0 py-3 bg-transparent" %>
  </div>

  <div>
    <%= form.label :content, class: "block text-sm font-semibold text-gray-900 mb-2" %>
    <%= form.text_area :content, placeholder: "Tell your story...", rows: 20, class: "w-full text-gray-700 placeholder-gray-400 border border-gray-200 rounded-md focus:border-gray-900 focus:ring-0 p-4 resize-none" %>
  </div>

  <div class="flex items-center justify-between pt-4">
    <%= link_to "Cancel", posts_path, class: "text-gray-500 hover:text-gray-700 text-sm font-medium" %>
    <%= form.submit class: "px-6 py-2 text-sm font-medium text-white bg-green-600 rounded-full hover:bg-green-500 cursor-pointer" %>
  </div>
<% end %>