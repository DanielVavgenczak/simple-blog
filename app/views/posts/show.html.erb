<% content_for :title, @post.title %>

<div class="max-w-2xl mx-auto">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-6 text-green-600 text-sm rounded-md" id="notice"><%= notice %></p>
  <% end %>

  <header class="mb-8">
    <h1 class="text-4xl font-bold text-gray-900 mb-4 leading-tight"><%= @post.title %></h1>
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-2 text-sm text-gray-500">
        <span><%= time_ago_in_words(@post.created_at) %> ago</span>
      </div>
      <div class="flex items-center space-x-3">
        <%= link_to "Edit", edit_post_path(@post), class: "text-sm text-gray-500 hover:text-gray-900 font-medium" %>
        <span class="text-gray-300">|</span>
        <%= button_to "Delete", @post, method: :delete, class: "text-sm text-red-500 hover:text-red-700 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
      </div>
    </div>
  </header>

  <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed">
    <%= simple_format(@post.content) %>
  </div>

  <div class="mt-12 pt-6 border-t border-gray-200">
    <%= link_to "← Back to posts", posts_path, class: "text-gray-500 hover:text-gray-700 text-sm font-medium" %>
  </div>
</div>